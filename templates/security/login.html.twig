{% extends 'base.html.twig' %}

{% block title %}Iniciar Sesión - SGI Electro{% endblock %}

{% block body %}
<div class="container-fluid flex-grow-1 d-flex align-items-center my-auto py-4">
    <div class="row w-100 justify-content-center align-items-center g-0">
        
        <!-- Columna Izquierda: Leyenda e Identidad Institucional -->
        <div class="col-lg-6 col-xl-5 p-4 p-md-5 text-center text-lg-start border-end-lg">
            <div class="pe-lg-4">
                <div class="bg-primary text-white d-inline-flex align-items-center justify-content-center rounded-3 mb-4 p-3 shadow-sm">
                    <i class="bi bi-lightning-charge-fill display-5"></i>
                </div>
                <h1 class="display-5 fw-bold text-dark mb-3">SGI Electro</h1>
                <h2 class="h4 text-primary fw-normal mb-3">Sistema de Gestión Integral Eléctrico</h2>
                <p class="text-secondary lead fs-6">
                    Plataforma centralizada para la administración, control y seguimiento de operaciones eléctricas y servicios.
                </p>
            </div>
        </div>

        <!-- Columna Derecha: Formulario de Login -->
        <div class="col-lg-5 col-xl-4 p-4 p-md-5">
            <div class="card border-0 shadow-lg rounded-4">
                <div class="card-body p-4 p-sm-5">
                    
                    <div class="mb-4">
                        <h3 class="fw-bold text-dark mb-1">Bienvenido</h3>
                        <p class="text-muted small">Ingresa tus credenciales para acceder al sistema</p>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
                            <small>{{ error.messageKey|trans(error.messageData, 'security') }}</small>
                        </div>
                    {% endif %}

                    {% if app.user %}
                        <div class="alert alert-info text-center mb-3">
                            Has iniciado sesión como <strong>{{ app.user.userIdentifier }}</strong>.
                            <div class="mt-3">
                                <a href="{{ path('app_home') }}" class="btn btn-sm btn-primary">Ir al Inicio</a>
                                <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-danger">Cerrar Sesión</a>
                            </div>
                        </div>
                    {% else %}
                        <form method="post">
                            <div class="form-floating mb-3">
                                <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="nombre@ejemplo.com">
                                <label for="inputEmail"><i class="bi bi-envelope me-1"></i> Correo electrónico</label>
                            </div>

                            <div class="form-floating mb-3">
                                <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="Contraseña">
                                <label for="inputPassword"><i class="bi bi-lock me-1"></i> Contraseña</label>
                            </div>

                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="form-check mb-3">
                                <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
                                <label class="form-check-label text-muted small" for="_remember_me">
                                    Recordarme en este equipo
                                </label>
                            </div>

                            <div class="d-grid gap-2 mt-4">
                                <button class="btn btn-primary btn-lg fw-bold py-3" type="submit">
                                    Ingresar al Sistema
                                </button>
                            </div>
                        </form>
                    {% endif %}

                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}Iniciar Sesión - SGI Electro{% endblock %}

{% block body %}
<div class="container d-flex flex-column justify-content-center align-items-center min-vh-100 py-5">
    <div class="card border-0 shadow-lg" style="max-width: 420px; width: 100%; border-radius: 1rem;">
        <div class="card-body p-4 p-sm-5">
            <!-- Header / Logo -->
            <div class="text-center mb-4">
                <div class="bg-primary text-white d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-shield-lock-fill fs-3"></i>
                </div>
                <h3 class="fw-bold text-dark">SGI Electro</h3>
                <p class="text-muted small">Ingresa tus credenciales para acceder</p>
            </div>

            {% if error %}
                <div class="alert alert-danger alert-dismissible fade show text-center mb-3" role="alert">
                    <small>{{ error.messageKey|trans(error.messageData, 'security') }}</small>
                </div>
            {% endif %}

            {% if app.user %}
                <div class="alert alert-info text-center mb-3">
                    Has iniciado sesión como <strong>{{ app.user.userIdentifier }}</strong>.
                    <div class="mt-2">
                        <a href="{{ path('app_home') }}" class="btn btn-sm btn-primary">Ir al Inicio</a>
                        <a href="{{ path('app_logout') }}" class="btn btn-sm btn-outline-danger">Cerrar Sesión</a>
                    </div>
                </div>
            {% else %}
                <form method="post">
                    <div class="form-floating mb-3">
                        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus placeholder="nombre@ejemplo.com">
                        <label for="inputEmail">Correo electrónico</label>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required placeholder="Contraseña">
                        <label for="inputPassword">Contraseña</label>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="_remember_me" id="_remember_me">
                        <label class="form-check-label text-muted small" for="_remember_me">
                            Recordarme en este equipo
                        </label>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button class="btn btn-primary btn-lg fw-bold" type="submit">
                            Ingresar
                        </button>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
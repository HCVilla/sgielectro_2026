{% extends 'base.html.twig' %}

{% block title %}Dashboard - SGI Electro{% endblock %}

{% block body %}
<!-- Navbar Superior -->
<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm border-bottom border-secondary">
  <div class="container-fluid px-3">
    <!-- Botón para alternar Sidebar en pantallas pequeñas -->
    <button class="btn btn-dark d-md-none me-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarMenu">
      <i class="bi bi-list fs-4"></i>
    </button>

    <a class="navbar-brand fw-bold d-flex align-items-center" href="{{ path('app_home') }}">
      <i class="bi bi-lightning-charge-fill text-warning me-2"></i> SGI Electro
    </a>

    <!-- Usuario y Logout -->
    <div class="d-flex align-items-center ms-auto">
      <span class="text-white-50 small me-3 d-none d-sm-inline">
        <i class="bi bi-person-circle me-1"></i> <strong>{{ app.user.userIdentifier }}</strong>
      </span>
      <a href="{{ path('app_logout') }}" class="btn btn-outline-danger btn-sm">
        <i class="bi bi-box-arrow-right me-1"></i> <span class="d-none d-sm-inline">Cerrar Sesión</span>
      </a>
    </div>
  </div>
</nav>

<!-- Layout Principal: Sidebar + Contenido -->
<div class="container-fluid">
  <div class="row">
    
    <!-- Sidebar Navegación (Fijo en PC / Offcanvas en móviles) -->
    <div class="col-md-3 col-lg-2 p-0 bg-white border-end shadow-sm">
      <div class="offcanvas-md offcanvas-start bg-white h-100" tabindex="-1" id="sidebarMenu" aria-labelledby="sidebarMenuLabel">
        
        <div class="offcanvas-header border-bottom">
          <h5 class="offcanvas-title fw-bold" id="sidebarMenuLabel">
            <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Menú Principal
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#sidebarMenu" aria-label="Close"></button>
        </div>

        <div class="offcanvas-body d-md-flex flex-column p-0 pt-3">
          <ul class="nav nav-pills flex-column mb-auto px-2">
            
            <li class="nav-item mb-1">
              <a href="{{ path('app_home') }}" class="nav-link active fw-semibold">
                <i class="bi bi-speedometer2 me-2"></i> Dashboard
              </a>
            </li>

            <li class="text-muted small fw-bold text-uppercase px-3 mt-3 mb-1">Módulos</li>

            <li class="nav-item mb-1">
              <a href="#" class="nav-link text-dark">
                <i class="bi bi-people me-2 text-primary"></i> Clientes
              </a>
            </li>

            <li class="nav-item mb-1">
              <a href="#" class="nav-link text-dark">
                <i class="bi bi-box-seam me-2 text-success"></i> Productos / Stock
              </a>
            </li>

            <li class="nav-item mb-1">
              <a href="#" class="nav-link text-dark">
                <i class="bi bi-file-earmark-text me-2 text-warning"></i> Pedidos / Órdenes
              </a>
            </li>

            {% if is_granted('ROLE_ADMIN') %}
              <li class="text-muted small fw-bold text-uppercase px-3 mt-3 mb-1">Administración</li>
              
              <li class="nav-item mb-1">
                <a href="#" class="nav-link text-dark">
                  <i class="bi bi-shield-lock me-2 text-danger"></i> Gestión de Usuarios
                </a>
              </li>

              <li class="nav-item mb-1">
                <a href="#" class="nav-link text-dark">
                  <i class="bi bi-gear me-2 text-secondary"></i> Configuración
                </a>
              </li>
            {% endif %}

          </ul>
        </div>

      </div>
    </div>

    <!-- Area de Contenido Central -->
    <main class="col-md-9 col-lg-10 ms-sm-auto px-md-4 py-4 bg-light">
      
      <!-- Encabezado de Sección -->
      <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pb-2 mb-3 border-bottom">
        <h1 class="h3 fw-bold text-dark">Panel de Control</h1>
        <span class="badge bg-primary px-3 py-2">Estado: Operativo</span>
      </div>

      <!-- Tarjetas Estadísticas / Accesos Rápido -->
      <div class="row g-3 mb-4">
        
        <div class="col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
              <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                <i class="bi bi-people fs-3"></i>
              </div>
              <div>
                <h6 class="card-subtitle text-muted mb-1">Clientes</h6>
                <h4 class="card-title fw-bold mb-0">--</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
              <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                <i class="bi bi-box-seam fs-3"></i>
              </div>
              <div>
                <h6 class="card-subtitle text-muted mb-1">Productos</h6>
                <h4 class="card-title fw-bold mb-0">--</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
              <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                <i class="bi bi-file-earmark-text fs-3"></i>
              </div>
              <div>
                <h6 class="card-subtitle text-muted mb-1">Pedidos Pendientes</h6>
                <h4 class="card-title fw-bold mb-0">--</h4>
              </div>
            </div>
          </div>
        </div>

        <div class="col-sm-6 col-xl-3">
          <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body d-flex align-items-center">
              <div class="bg-danger bg-opacity-10 text-danger rounded-3 p-3 me-3">
                <i class="bi bi-shield-check fs-3"></i>
              </div>
              <div>
                <h6 class="card-subtitle text-muted mb-1">Rol de Usuario</h6>
                <h6 class="card-title fw-bold mb-0 text-uppercase">
                  {{ app.user.roles[0]|replace({'ROLE_': ''}) }}
                </h6>
              </div>
            </div>
          </div>
        </div>

      </div>

    </main>

  </div>
</div>
{% endblock %}